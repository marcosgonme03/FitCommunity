# =============================================================================
# FitCommunity — Variables de Entorno
# =============================================================================
# Copia este archivo:
#   • backend  →  apps/backend/.env
#   • frontend →  apps/frontend/.env  (solo VITE_API_URL)
#
# Nunca commitees archivos .env con credenciales reales.
# =============================================================================

# ─── APP ──────────────────────────────────────────────────────────────────────
NODE_ENV=development           # development | production | test
PORT=3001                      # Puerto del servidor Express
FRONTEND_URL=http://localhost:5174
API_URL=http://localhost:3001

# ─── BASE DE DATOS (PostgreSQL) ───────────────────────────────────────────────
# Opción A — Supabase (producción y staging recomendado)
#   Transaction pooler (puerto 6543) → para runtime de la app
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1"
#   Session pooler (puerto 5432) → para prisma db push / studio
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Opción B — Docker Compose local
# DATABASE_URL="postgresql://fitcommunity:fitcommunity_secret@localhost:5432/fitcommunity_dev"
# Variables para el contenedor Docker (solo si usas docker-compose.yml):
POSTGRES_USER=fitcommunity
POSTGRES_PASSWORD=fitcommunity_secret
POSTGRES_DB=fitcommunity_dev

# ─── REDIS ────────────────────────────────────────────────────────────────────
# Docker local: docker run -d -p 6379:6379 redis:7-alpine
REDIS_URL=redis://:redis_secret@localhost:6379
REDIS_PASSWORD=redis_secret

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Genera secretos con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CAMBIA_ESTO_access_secret_minimo_64_caracteres_aleatorios
JWT_REFRESH_SECRET=CAMBIA_ESTO_refresh_secret_minimo_64_caracteres_aleatorios
JWT_ACCESS_EXPIRES_IN=15m      # Expiración del access token
JWT_REFRESH_EXPIRES_IN=7d      # Expiración del refresh token

# ─── EMAIL (Nodemailer) ───────────────────────────────────────────────────────
# Desarrollo: Mailtrap (https://mailtrap.io) — bandeja de pruebas gratuita
# Producción: SendGrid / Resend / SES (reemplaza host/user/pass)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false              # true si usas puerto 465
SMTP_USER=tu_usuario_mailtrap
SMTP_PASS=tu_password_mailtrap
EMAIL_FROM="FitCommunity <noreply@fitcommunity.app>"

# ─── 2FA (TOTP) ───────────────────────────────────────────────────────────────
TOTP_APP_NAME=FitCommunity     # Nombre que aparece en Google Authenticator

# ─── SEGURIDAD ────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12          # 10–14 recomendado (mayor = más lento = más seguro)
LOG_LEVEL=debug                # error | warn | info | debug

# ─── RATE LIMITING ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000    # Ventana de 15 minutos (en milisegundos)
RATE_LIMIT_MAX_REQUESTS=100    # Máximo de peticiones generales por ventana
AUTH_RATE_LIMIT_MAX=20         # Máximo de peticiones de auth por ventana

# ─── STRIPE (Planes Premium) ──────────────────────────────────────────────────
# 1. Crea cuenta en https://stripe.com (modo TEST)
# 2. Dashboard → Productos → Crea "FitCommunity Premium" (4,99 €/mes recurrente)
#    Copia el price_id resultante (price_...)
# 3. Dashboard → Developers → API keys → copia la Secret key de TEST (sk_test_...)
# 4. Para webhooks en local, instala Stripe CLI y ejecuta:
#      stripe listen --forward-to localhost:3001/api/billing/webhook
#    El comando te dará el whsec_... para STRIPE_WEBHOOK_SECRET
# Tarjeta de prueba: 4242 4242 4242 4242 (cualquier fecha futura, cualquier CVC)
STRIPE_SECRET_KEY=REEMPLAZA_CON_TU_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=REEMPLAZA_CON_TU_STRIPE_PUBLISHABLE_KEY
STRIPE_PRICE_ID=REEMPLAZA_CON_TU_STRIPE_PRICE_ID
STRIPE_WEBHOOK_SECRET=REEMPLAZA_CON_TU_STRIPE_WEBHOOK_SECRET

# ─── GROQ (IA Premium — Coach virtual) ───────────────────────────────────────
# Free tier sin tarjeta requerida.
# 1. Crea cuenta en https://console.groq.com
# 2. Personal → Default Project → Create API Key → copia la clave (gsk_...)
# Modelos disponibles:
#   llama-3.3-70b-versatile  → calidad alta, JSON mode, ~500 tok/s (default)
#   llama-3.1-8b-instant     → más rápido y barato, menor calidad
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# ─── OAUTH (boilerplate — habilitar en sprint futuro) ─────────────────────────
# GOOGLE_CLIENT_ID=tu_google_client_id
# GOOGLE_CLIENT_SECRET=tu_google_client_secret
# APPLE_CLIENT_ID=tu_apple_client_id
# APPLE_TEAM_ID=tu_apple_team_id
# APPLE_KEY_ID=tu_apple_key_id

# ─── ALMACENAMIENTO (imágenes avatares/workouts) ──────────────────────────────
# Habilitar cuando se implemente upload a S3 / Supabase Storage
# AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=tu_aws_access_key
# AWS_SECRET_ACCESS_KEY=tu_aws_secret_key
# AWS_S3_BUCKET=fitcommunity-uploads

# ─── PGADMIN (solo Docker local) ──────────────────────────────────────────────
PGADMIN_EMAIL=admin@fitcommunity.local
PGADMIN_PASSWORD=admin

# =============================================================================
# FRONTEND (apps/frontend/.env)
# =============================================================================
# En producción, el frontend y el backend están en el mismo dominio (Vite proxy).
# VITE_API_URL=/api
